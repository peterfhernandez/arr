# Copy this file to .env and fill in your own values.
# Never commit the real .env (with VPN credentials) to a public repo.

TZ=Australia/Sydney

# --- Gluetun VPN settings ---
# Provider name as gluetun expects it, e.g. mullvad, protonvpn, private internet access, surfshark.
# For CyberGhost specifically, use "custom" instead of "cyberghost" — see
# HOWTO.md step 2a for why (gluetun's built-in cyberghost server list can
# point at different infrastructure than your cert/credentials are valid
# for, causing AUTH_FAILED). Custom mode uses your provider-supplied .ovpn
# file directly (place it at config/gluetun/custom.conf).
VPN_SERVICE_PROVIDER=
# openvpn or wireguard (check what your provider supports; wireguard is lighter/faster)
VPN_TYPE=wireguard

# If VPN_TYPE=openvpn (required for VPN_SERVICE_PROVIDER=custom too)
OPENVPN_USER=
OPENVPN_PASSWORD=

# If VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=

# Optional: restrict exit servers to specific countries, comma separated.
# MUST be left empty when VPN_SERVICE_PROVIDER=custom — gluetun errors out
# at startup if this is set, since custom mode has no server list to filter
# (the exact server is whatever your custom.conf file specifies).
VPN_SERVER_COUNTRIES=
